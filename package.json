{
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "bash build.sh",
    "check-links": "remark content/projects/",
    "clean": "rm -rf public",
    "dev": "bash scripts/dev.sh",
    "format": "run-s format:*",
    "format:code": "prettier --write . --ignore-path .prettierignore",
    "format:css": "npm run lint:css -- --fix",
    "format:pkg": "format-package -w",
    "lint": "run-p lint:*",
    "lint:css": "stylelint 'static/style.css'",
    "lint:grammar": "write-good $(glob 'content/projects/**/*.md') --no-tooWordy",
    "lint:spelling": "cspell '**' --no-progress",
    "resume-pdf": "node scripts/resume-pdf.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "start": "bash scripts/dev.sh",
    "test": "run-p check-links lint"
  },
  "cspell": {
    "dictionaries": [
      "companies",
      "css",
      "custom-words",
      "en_US",
      "filetypes",
      "fonts",
      "html",
      "latex",
      "node",
      "npm",
      "softwareTerms"
    ],
    "dictionaryDefinitions": [
      {
        "name": "custom-words",
        "path": "./custom-words.txt",
        "addWords": true
      }
    ],
    "ignorePaths": [
      "package-lock.json",
      "public",
      "screenshots",
      "ssg/target",
      "static/prism.css",
      "static/temml.css"
    ],
    "language": "en",
    "useGitignore": true,
    "version": "0.2"
  },
  "prettier": {
    "proseWrap": "always",
    "trailingComma": "all"
  },
  "remarkConfig": {
    "plugins": [
      "remark-lint-no-dead-urls"
    ]
  },
  "stylelint": {
    "extends": [
      "stylelint-config-standard"
    ],
    "plugins": [
      "stylelint-order",
      "stylelint-value-no-unknown-custom-properties"
    ],
    "rules": {
      "order/properties-alphabetical-order": true,
      "value-keyword-case": [
        "lower",
        {
          "camelCaseSvgKeywords": true,
          "ignoreProperties": [
            "text-rendering"
          ]
        }
      ],
      "csstools/value-no-unknown-custom-properties": [
        true,
        {
          "importFrom": [
            "static/style.css"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "mdast-util-from-markdown": "^0.8.5",
    "prismjs": "^1.29.0",
    "temml": "^0.11.11"
  },
  "devDependencies": {
    "cli-glob": "^0.1.0",
    "cspell": "^6.31.1",
    "format-package": "^7.0.0",
    "gifuct-js": "^2.1.2",
    "netlify-plugin-cache": "^1.0.3",
    "npm-run-all": "^4.1.5",
    "oxipng": "^1.0.1",
    "playwright": "^1.49.0",
    "pngjs": "^7.0.0",
    "prettier": "^2.8.8",
    "remark-cli": "^11.0.0",
    "remark-lint-no-dead-urls": "^1.1.0",
    "stylelint": "^15.6.0",
    "stylelint-config-standard": "^33.0.0",
    "stylelint-order": "^6.0.3",
    "stylelint-value-no-unknown-custom-properties": "^4.0.0",
    "write-good": "^1.0.8"
  }
}
