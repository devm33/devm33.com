{
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.js",
    "cbs": "run-s clean build serve",
    "check-links": "remark -f src/projects/",
    "clean": "rm -rf public",
    "format": "run-s format:*",
    "format:code": "prettier --write . --ignore-path .gitignore",
    "format:css": "npm run lint:css -- --fix",
    "format:pkg": "format-package -w",
    "lint": "run-p lint:*",
    "lint:css": "stylelint 'src/**/*.css'",
    "lint:grammar": "write-good $(glob 'src/projects/**/*.md') --no-tooWordy",
    "lint:spelling": "cspell '**' --no-progress",
    "serve": "npx serve public",
    "start": "npm run build && npm run serve",
    "test": "run-p check-links lint"
  },
  "browserslist": [
    "defaults and supports es6-module"
  ],
  "cspell": {
    "dictionaries": [
      "companies",
      "css",
      "custom-words",
      "en_US",
      "filetypes",
      "fonts",
      "html",
      "latex",
      "node",
      "npm",
      "softwareTerms"
    ],
    "dictionaryDefinitions": [
      {
        "name": "custom-words",
        "path": "./src/custom-words.txt",
        "addWords": true
      }
    ],
    "ignorePaths": [
      "package-lock.json"
    ],
    "language": "en",
    "useGitignore": true,
    "version": "0.2"
  },
  "prettier": {
    "proseWrap": "always",
    "trailingComma": "all"
  },
  "remarkConfig": {
    "plugins": [
      "remark-lint-no-dead-urls"
    ]
  },
  "stylelint": {
    "extends": [
      "stylelint-config-standard"
    ],
    "plugins": [
      "stylelint-order",
      "stylelint-value-no-unknown-custom-properties"
    ],
    "rules": {
      "order/properties-alphabetical-order": true,
      "value-keyword-case": [
        "lower",
        {
          "camelCaseSvgKeywords": true,
          "ignoreProperties": [
            "text-rendering"
          ]
        }
      ],
      "csstools/value-no-unknown-custom-properties": [
        true,
        {
          "importFrom": [
            "src/global.css"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "katex": "^0.16.6",
    "marked": "^17.0.0",
    "prismjs": "^1.29.0",
    "puppeteer": "^24.0.0",
    "sharp": "^0.34.0"
  },
  "devDependencies": {
    "cli-glob": "^0.1.0",
    "cspell": "^6.31.1",
    "format-package": "^7.0.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.8.8",
    "remark-cli": "^11.0.0",
    "remark-lint-no-dead-urls": "^1.1.0",
    "stylelint": "^15.6.0",
    "stylelint-config-standard": "^33.0.0",
    "stylelint-order": "^6.0.3",
    "stylelint-value-no-unknown-custom-properties": "^4.0.0",
    "write-good": "^1.0.8"
  }
}
